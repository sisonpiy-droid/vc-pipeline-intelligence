# Copy to .env for local use; set the same names in Vercel → Project → Settings → Environment Variables.
# Placeholders only. NEVER commit real values. All of these are SERVER-SIDE secrets: none reach the browser.

# ── Database (Supabase Postgres) ───────────────────────────────────────────────────────────────
# Supabase dashboard → Connect → "Transaction pooler" (port 6543). There is no browser-side Supabase
# client and no service-role key in this app: the server talks to Postgres directly and RLS denies the
# public Data API everything.
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Local-only alternative (in-process Postgres under .data/, nothing leaves your machine):
# DATABASE_URL=pglite://.data/dev

# ── AI: Gemini Flash is the only model this app calls ─────────────────────────────────────────
GEMINI_API_KEY=
# Optional. Defaults to gemini-3.6-flash. `npm run check:live` verifies the id exists.
# GEMINI_MODEL=gemini-3.6-flash

# Optional backups so the product keeps working if Google's free quota runs out. Both reach the SAME Gemini Flash model and are
# only tried after the first key fails. Leave blank to run on GEMINI_API_KEY alone.
# A second Google key, ideally from a different Google project (it has its own free quota):
GEMINI_API_KEY_2=
# The same model through OpenRouter (paid per use, cents per refresh). Used only if both Google routes fail:
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=google/gemini-3.6-flash

# ── Search: Tavily (https://tavily.com) ───────────────────────────────────────────────────────
TAVILY_API_KEY=

# ── Scheduled refresh ─────────────────────────────────────────────────────────────────────────
# Vercel Cron sends this as `Authorization: Bearer $CRON_SECRET`. Generate a long random value:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# ── Manual refresh button ─────────────────────────────────────────────────────────────────────
# Passcode typed into the dashboard's "Refresh now" popover. If unset, manual refresh is disabled (503).
ADMIN_PASSCODE=

# ── Free-tier guard rails (all optional; defaults shown) ───────────────────────────────────────
# Monthly Tavily search-credit cap enforced by the run planner, and credits spent outside tracked runs
# (tests, live checks, a key shared with another project). Use 0 for a brand-new key.
# TAVILY_MONTHLY_BUDGET=900
# TAVILY_CREDITS_BASELINE=0
# Skip investors checked within this many hours; search "cold" investors only this often (days).
# RECENT_CHECK_HOURS=36
# COLD_CHECK_DAYS=6.5
# Set to 0 to disable reading firms' own RSS/Atom feeds (free, no search credits).
# OFFICIAL_FEEDS=1

# ── Open demo mode ─────────────────────────────────────────────────────────────────────────────
# 1 = the Refresh and Edit buttons need NO passcode (for a live demo). Anyone with the link can then edit notes and
# start refreshes (still limited by the 10-minute cooldown and the credit budget). Default off: ADMIN_PASSCODE required.
# DEMO_OPEN=1

# ── Optional ──────────────────────────────────────────────────────────────────────────────────
# Set to 1 on a PUBLIC deployment to hide personal notes / contact history on the investor page.
# HIDE_PRIVATE_NOTES=1

# The introduction emails (they open in your own mail app; this application never sends them).
# Anything left unset appears in the draft as a visible [placeholder].
# FOUNDER_NAME=
# STARTUP_NAME=
# STARTUP_BRIEF=We build ... for ...; <one line of traction>.
# CALENDLY_URL=https://calendly.com/your-name/20min
