# Copy to .env (local) and set the same names in Vercel → Project → Settings → Environment Variables.
# Placeholders only. NEVER commit real values.

# Supabase Postgres — server-side only. Dashboard → Connect → "Transaction pooler" (port 6543).
# There is no browser-side database client and no service-role key in this app.
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres
